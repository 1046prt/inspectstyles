{
  "manifest_version": 3,
  "name": "InspectStyles",
  "version": "2.0.0",
  "description": "Inspect fonts, colors, contrast and spacing on any webpage. Pick colors, save palettes, export CSS.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "InspectStyles",
    "default_icon": {
      "16": "icons/InspectStyles.png",
      "48": "icons/InspectStyles.png",
      "128": "icons/InspectStyles.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Turn the inspector on or off"
    }
  },
  "icons": {
    "16": "icons/InspectStyles.png",
    "48": "icons/InspectStyles.png",
    "128": "icons/InspectStyles.png"
  }
}

{
  "manifest_version": 3,
  "name": "InspectStyles",
  "version": "1.0.0",
  "description": "Font & Color Identifier - Inspect fonts and colors used on any webpage in real time",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "InspectStyles",
    "default_icon": {
      "16": "icons/InspectStyles.png",
      "48": "icons/InspectStyles.png",
      "128": "icons/InspectStyles.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles/sidebar.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/InspectStyles.png",
    "48": "icons/InspectStyles.png",
    "128": "icons/InspectStyles.png"
  }
}
